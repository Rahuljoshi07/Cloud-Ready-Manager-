# Server
PORT=5000
NODE_ENV=development

# Database — choose one approach:
# Option A: Full connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/azure_cost_monitor

# Option B: Individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=azure_cost_monitor
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Azure Credentials (optional — backend runs on mock data without these)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default admin account (created on first boot)
ADMIN_EMAIL=admin@contoso.com
ADMIN_PASSWORD=Admin@123

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email alerts (SMTP) — optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Slack alerts — optional
SLACK_WEBHOOK_URL=
