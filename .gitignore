# Azure Cloud Cost Monitor - .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
frontend/build/
backend/dist/

# Environment files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# Database
*.sqlite
*.sqlite3

# Docker volumes
postgres_data/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/
.nyc_output

# Temporary files
tmp/
temp/
*.tmp

# PDF reports (generated at runtime)
reports/*.pdf
